{
  "name": "helicopter-humans",
  "version": "1.0.0",
  "description": "A privacy layer for your agent. Don't be a helicopter human.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-offline.mjs && node scripts/build-memory-cleaner.mjs",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run && npm run test:packages",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:packages": "npm test --workspaces --if-present",
    "test:memory-cleaner": "python3 -m unittest discover -s tools/memory-cleaner/tests -p 'test_*.py' -v",
    "test:pg": "vitest run src/checkout/store-postgres.test.ts",
    "smoke:functions": "node scripts/smoke-functions.mjs",
    "tools:build": "vite build --config vite.tools.config.ts --logLevel warn",
    "relay": "npm run tools:build && node .tools-build/relay.js",
    "sandbox": "npm run tools:build && node --env-file-if-exists=.env.sandbox .tools-build/sandbox-preflight.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/water-bear86/helicopter-humans.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/water-bear86/helicopter-humans/issues"
  },
  "homepage": "https://github.com/water-bear86/helicopter-humans#readme",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@helicopter-humans/payment-adapter": "0.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
