# Build-time (public, baked into the static site). Price text only; nothing here can open checkout.
VITE_PRICE_LABEL=
# Server-side (api/). "disabled" or "cipherpay-zcash-shielded". Selecting the Zcash adapter does not
# enable collection: it stays off until the live-readiness blockers are cleared in code.
PAYMENT_ADAPTER=disabled
# Local development only: "fixture" runs the checkout preview against a simulated provider and an
# in-memory store. Ignored on every hosted deployment. See docs/CHECKOUT.md.
CHECKOUT_MODE=
# Not read while the checkout blockers stand. Server-only, never VITE_-prefixed; see docs/CHECKOUT.md.
# CIPHERPAY_API_KEY=
# CHECKOUT_DATABASE_URL=
